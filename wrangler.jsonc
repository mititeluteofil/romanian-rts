{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker serves both the static game (./dist) and the lockstep relay.
  // Static files are served directly; anything that is not an asset (e.g. the
  // WebSocket upgrade to /relay?room=...) falls through to worker/index.ts.
  "name": "romanian-rts",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOM",
        "class_name": "MatchRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"]
    }
  ]
}
